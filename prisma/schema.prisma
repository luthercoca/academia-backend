generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum EstadoEstudiante {
  ACTIVO
  INACTIVO
  EGRESADO
  RETIRADO
}

enum EstadoCurso {
  ACTIVO
  INACTIVO
}

enum EstadoMateria {
  ACTIVA
  INACTIVA
}

enum EstadoDocente {
  ACTIVO
  INACTIVO
}

enum EstadoPeriodo {
  PLANIFICADO
  ACTIVO
  FINALIZADO
}

enum EstadoAula {
  ACTIVA
  INACTIVA
}

enum EstadoHorario {
  ACTIVO
  INACTIVO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
}

enum EstadoAsignacion {
  ACTIVA
  INACTIVA
}

enum EstadoInscripcion {
  ACTIVA
  RETIRADA
  FINALIZADA
}

enum RolUsuario {
  ADMIN
  DOCENTE
  ESTUDIANTE
}

enum TipoEvaluacion {
  PARCIAL
  FINAL
  PRACTICA
  TAREA
  PROYECTO
  PARTICIPACION
  OTRA
}

model Estudiante {
  id              Int              @id @default(autoincrement())
  codigo          String           @unique
  nombres         String
  apellidos       String
  documento       String           @unique
  email           String?
  telefono        String?
  fechaNacimiento DateTime?
  estado          EstadoEstudiante @default(ACTIVO)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  inscripciones Inscripcion[]
  usuario       Usuario?

  @@map("estudiantes")
}

model Docente {
  id         Int           @id @default(autoincrement())
  codigo     String        @unique
  nombres    String
  apellidos  String
  email      String?
  telefono   String?
  estado     EstadoDocente @default(ACTIVO)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  calificaciones Calificacion[]
  usuario        Usuario?
  asignaciones   AsignacionDocente[]

  @@map("docentes")
}

model Curso {
  id        Int         @id @default(autoincrement())
  nombre    String
  nivel     String
  paralelo  String?
  capacidad Int?
  estado    EstadoCurso @default(ACTIVO)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  inscripciones Inscripcion[]
  asignaciones  AsignacionDocente[]

  @@map("cursos")
}

model Materia {
  id             Int           @id @default(autoincrement())
  codigo         String        @unique
  nombre         String
  descripcion    String?
  horasSemanales Int?
  estado         EstadoMateria @default(ACTIVA)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  calificaciones Calificacion[]
  asignaciones   AsignacionDocente[]

  @@map("materias")
}

model PeriodoAcademico {
  id          Int           @id @default(autoincrement())
  nombre      String
  fechaInicio DateTime
  fechaFin    DateTime
  estado      EstadoPeriodo @default(PLANIFICADO)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  inscripciones Inscripcion[]
  asignaciones  AsignacionDocente[]

  @@map("periodos_academicos")
}

/// Qué materia imparte cada docente, en qué curso y en qué período académico.
/// Un docente puede tener varias; una misma materia+curso+período tiene un solo docente ACTIVO (lo valida el servicio).
model AsignacionDocente {
  id                 Int              @id @default(autoincrement())
  docenteId          Int
  materiaId          Int
  cursoId            Int
  periodoAcademicoId Int
  estado             EstadoAsignacion @default(ACTIVA)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  docente          Docente          @relation(fields: [docenteId], references: [id])
  materia          Materia          @relation(fields: [materiaId], references: [id])
  curso            Curso            @relation(fields: [cursoId], references: [id])
  periodoAcademico PeriodoAcademico @relation(fields: [periodoAcademicoId], references: [id])
  horarios         Horario[]

  @@unique([docenteId, materiaId, cursoId, periodoAcademicoId], map: "asignacion_docente_unica")
  @@index([materiaId, cursoId, periodoAcademicoId], map: "asignacion_materia_curso_periodo_idx")
  @@index([cursoId, periodoAcademicoId], map: "asignacion_curso_periodo_idx")
  @@map("asignaciones_docentes")
}

/// Ambientes donde se pasan clases (aula, laboratorio, sala…).
model Aula {
  id        Int        @id @default(autoincrement())
  codigo    String     @unique
  nombre    String
  capacidad Int?
  ubicacion String?
  estado    EstadoAula @default(ACTIVA)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  horarios Horario[]

  @@map("aulas")
}

/// Un bloque del horario semanal: la asignación (materia + docente + curso/paralelo + período) en un aula, un día y un rango de horas.
/// Horas en texto «HH:MM» (24 h). El servicio impide cruces de aula, docente y curso.
model Horario {
  id           Int           @id @default(autoincrement())
  asignacionId Int
  aulaId       Int
  diaSemana    DiaSemana
  horaInicio   String        @db.VarChar(5)
  horaFin      String        @db.VarChar(5)
  estado       EstadoHorario @default(ACTIVO)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  asignacion AsignacionDocente @relation(fields: [asignacionId], references: [id])
  aula       Aula              @relation(fields: [aulaId], references: [id])

  @@index([aulaId, diaSemana], map: "horario_aula_dia_idx")
  @@index([asignacionId], map: "horario_asignacion_idx")
  @@map("horarios")
}

model Inscripcion {
  id                 Int               @id @default(autoincrement())
  estudianteId       Int
  cursoId            Int
  periodoAcademicoId Int
  fechaInscripcion   DateTime          @default(now())
  estado             EstadoInscripcion @default(ACTIVA)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  estudiante       Estudiante       @relation(fields: [estudianteId], references: [id])
  curso            Curso            @relation(fields: [cursoId], references: [id])
  periodoAcademico PeriodoAcademico @relation(fields: [periodoAcademicoId], references: [id])
  calificaciones   Calificacion[]

  @@unique([estudianteId, cursoId, periodoAcademicoId])
  @@map("inscripciones")
}

model Calificacion {
  id            Int            @id @default(autoincrement())
  inscripcionId Int
  materiaId     Int
  docenteId     Int?
  nota          Float
  tipo          TipoEvaluacion
  fecha         DateTime       @default(now())
  observacion   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  inscripcion Inscripcion @relation(fields: [inscripcionId], references: [id])
  materia     Materia     @relation(fields: [materiaId], references: [id])
  docente     Docente?    @relation(fields: [docenteId], references: [id])

  @@map("calificaciones")
}

model Usuario {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  rol          RolUsuario
  activo       Boolean    @default(true)
  estudianteId Int?       @unique
  docenteId    Int?       @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  estudiante Estudiante? @relation(fields: [estudianteId], references: [id])
  docente    Docente?    @relation(fields: [docenteId], references: [id])
  bitacora   Bitacora[]

  @@map("usuarios")
}

enum AccionBitacora {
  CREAR
  MODIFICAR
  DESACTIVAR
  ELIMINAR
}

/// Registro de quién creó, modificó, desactivó o eliminó algo (lo escribe BitacoraInterceptor).
model Bitacora {
  id          Int            @id @default(autoincrement())
  fecha       DateTime       @default(now())
  usuarioId   Int?
  accion      AccionBitacora
  recurso     String         @db.VarChar(40)
  recursoId   Int?
  descripcion String         @db.VarChar(255)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([recurso, fecha])
  @@index([usuarioId, fecha])
  @@map("bitacora")
}

/// Datos de la institución (una sola fila, id = 1): nombre, sigla y logotipo que muestra el sistema.
model Configuracion {
  id                Int      @id @default(1)
  nombreInstitucion String   @db.VarChar(150)
  sigla             String?  @db.VarChar(20)
  /// Imagen PNG/JPG/WEBP de hasta 1 MB. Se guarda en la base porque Render gratis no conserva archivos en disco.
  logo              Bytes?   @db.MediumBlob
  logoTipo          String?  @db.VarChar(40)
  /// Despertador: si está encendido, el servidor se visita cada 10 min para que Render y Aiven no se duerman.
  despertadorActivo Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  @@map("configuracion")
}
